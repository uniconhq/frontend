# Browser-facing Forgejo URL, baked into the bundle at build time.
VITE_FORGE_URL=http://localhost:3300

# Where `pnpm dev` forwards /api and /healthz. Read by vite.config.ts, not by
# the app.
VITE_API_PROXY=http://localhost:8080

# What the backend believes its own public URL is (UNICON_PUBLIC_URL). The dev
# proxy presents requests as coming from here, because the backend refuses a
# write from any other origin.
VITE_API_ORIGIN=http://localhost:8080
